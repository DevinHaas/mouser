---
import Layout from '../layouts/Layout.astro'
import { Podium } from '@/components/podium'
import { MusicViz } from '@/components/music-viz'
import { padTop3 } from '@/lib/mock-leaderboard'
import { bestRunPerUser, boardSize } from '@/lib/leaderboard-query'
import { paging, PAGE_SIZE, PODIUM } from '@/lib/paging'
import { fmtTime } from '@/lib/format'
import { MOUSELESS_TOOL_BY_ID } from '@/lib/mouseless-tools'
import { captureServerError } from '@/lib/analytics.server'

const board = bestRunPerUser

// ponytail: the board is cosmetic — a DB hiccup shows mock rows, not a 500.
const totals = await boardSize().catch((error) => {
  captureServerError(error, { operation: 'load_leaderboard_size' })
  return [{ n: 0 }]
})

const { page, pages, offset, firstRank } = paging(
  totals[0]?.n ?? 0,
  Number(Astro.url.searchParams.get('page') ?? 1),
)

const [top3, rest] = await Promise.all([
  board().limit(PODIUM).catch((error) => {
    captureServerError(error, { operation: 'load_leaderboard_podium' })
    return []
  }),
  board().limit(PAGE_SIZE).offset(offset).catch((error) => {
    captureServerError(error, { operation: 'load_leaderboard_page', page })
    return []
  }),
])

const podium = padTop3(top3)
---

<Layout>
  <audio src="/music/leaderbord.mp3" autoplay loop></audio>
  <MusicViz client:only="react" />
  <main class="leaderboard">
    <h1 class="title-fx">
      <span class="t-sticker">LEADERBOARD</span>
      <span class="t-extrude">LEADERBOARD</span>
      <span class="t-highlight">LEADERBOARD</span>
      <span class="t-fill">LEADERBOARD</span>
    </h1>
    <p class="leaderboard-sub">MOUSELESS RUNS ONLY</p>
    <div class="podium">
      <Podium entries={podium} client:only="react" />
    </div>
    <ol class="rows">
      {rest.map((r, i) => {
        const tool = r.mouselessTool ? MOUSELESS_TOOL_BY_ID.get(r.mouselessTool) : null
        return (
          <li>
            <span class="rank">{firstRank + i}</span>
            <span class="name">
              {r.name}
              {tool && (
                <a class="tool-badge" href={tool.website} target="_blank" rel="noreferrer" style={`--tool-color:${tool.color}`} title={tool.name}>
                  <img class="tool-badge-logo" src={tool.logo} alt="" width="14" height="14" loading="lazy" />
                  {tool.name}
                </a>
              )}
            </span>
            <span class="time">{fmtTime(r.timeMs)}</span>
          </li>
        )
      })}
      {rest.length === 0 && <li class="empty">No runs past the podium yet.</li>}
    </ol>

    {pages > 1 && (
      <nav class="pager" aria-label="Leaderboard pages">
        <a href={`?page=${page - 1}`} aria-disabled={page === 1} class={page === 1 ? 'off' : ''}>&larr; prev</a>
        <span>{page} / {pages}</span>
        <a href={`?page=${page + 1}`} aria-disabled={page === pages} class={page === pages ? 'off' : ''}>next &rarr;</a>
      </nav>
    )}
    <div class="actions">
      <a href="/?play=1" class="frame-btn play-again">PLAY AGAIN</a>
    </div>
    <a href="/" class="back-link"><span class="pixel-arrow" aria-hidden="true"></span>DASHBOARD</a>
  </main>
</Layout>

<style>
  .leaderboard {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 24px;
    color: #f0c4bc;
    font-family: 'Press Start 2P', system-ui, sans-serif;
    font-size: 12px;
  }
  h1 {
    justify-items: center;
  }
  h1 > span {
    font-size: clamp(40px, 9vw, 104px);
  }
  .leaderboard-sub {
    margin: -14px 0 0;
    text-align: center;
    font-size: 10px;
    letter-spacing: 2px;
    opacity: 0.7;
  }
  .rows {
    justify-self: center;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    width: min(520px, 92vw);
  }
  .rows li {
    display: grid;
    grid-template-columns: 3ch 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 7px 12px;
    line-height: 1;
    background: rgba(240, 196, 188, 0.04);
  }
  .rows li:nth-child(odd) {
    background: rgba(240, 196, 188, 0.08);
  }
  .rank {
    opacity: 0.5;
    font-size: 10px;
  }
  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tool-badge {
    font-size: 7px;
    letter-spacing: 0.5px;
    padding: 3px 6px;
    border-radius: 3px;
    color: var(--tool-color);
    border: 1px solid var(--tool-color);
    text-decoration: none;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .tool-badge-logo {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    object-fit: contain;
  }
  .time {
    color: #b9a6ff;
    font-variant-numeric: tabular-nums;
  }
  .pager {
    justify-self: center;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    font-size: 10px;
  }
  .pager .off {
    opacity: 0.3;
    pointer-events: none;
  }
  .podium {
    justify-self: center;
    width: min(900px, 92vw);
    height: 420px;
  }
  .rows .empty {
    display: block;
    padding: 14px 12px;
    text-align: center;
    opacity: 0.6;
  }
  a {
    color: #b03422;
    text-align: center;
  }
  .actions {
    justify-self: center;
    display: grid;
    justify-items: center;
    gap: 14px;
  }
</style>
